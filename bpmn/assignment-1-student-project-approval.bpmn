<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_StudentProjectApproval"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.23.0"
                  modeler:executionPlatform="Camunda Platform"
                  modeler:executionPlatformVersion="7.21.0">
    <bpmn:message id="Message_Withdraw" name="Withdrawal after approval" />
    <bpmn:message id="Message_1" name="Guide acceptance" />
    <bpmn:message id="Message_Decline" name="Guide decline" />
    <bpmn:collaboration id="Collaboration_StudentProjectApproval">
      <bpmn:participant id="Pool_SPA" name="Student Project Approval and Allocation" processRef="StudentProjectApproval" />
    </bpmn:collaboration>
    <bpmn:process id="StudentProjectApproval" name="Student Project Approval and Allocation" isExecutable="true">
      <bpmn:laneSet id="LaneSet_StudentProjectApproval">
        <bpmn:lane id="Lane_Student" name="Student / Team"><bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef><bpmn:flowNodeRef>UT_Submit</bpmn:flowNodeRef><bpmn:flowNodeRef>ST_NotifyInvalid</bpmn:flowNodeRef><bpmn:flowNodeRef>End_InvalidTeam</bpmn:flowNodeRef><bpmn:flowNodeRef>UT_Ethics</bpmn:flowNodeRef><bpmn:flowNodeRef>UT_Revise</bpmn:flowNodeRef><bpmn:flowNodeRef>XOR_NewTopic</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Rejected</bpmn:flowNodeRef><bpmn:flowNodeRef>ST_RecordAlloc</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Allocated</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Withdrawn</bpmn:flowNodeRef><bpmn:flowNodeRef>UT_FixValidation</bpmn:flowNodeRef><bpmn:flowNodeRef>Boundary_Deadline</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Coordinator" name="Project Coordinator"><bpmn:flowNodeRef>UT_Screen</bpmn:flowNodeRef><bpmn:flowNodeRef>BR_EthicsLab</bpmn:flowNodeRef><bpmn:flowNodeRef>OR_SplitClearance</bpmn:flowNodeRef><bpmn:flowNodeRef>UT_Lab</bpmn:flowNodeRef><bpmn:flowNodeRef>OR_JoinClearance</bpmn:flowNodeRef><bpmn:flowNodeRef>UT_ReviewMatch</bpmn:flowNodeRef><bpmn:flowNodeRef>XOR_MatchDec</bpmn:flowNodeRef><bpmn:flowNodeRef>UT_ManualGuide</bpmn:flowNodeRef><bpmn:flowNodeRef>MSG_Decline</bpmn:flowNodeRef><bpmn:flowNodeRef>XOR_AllocTries</bpmn:flowNodeRef><bpmn:flowNodeRef>UT_LateApprove</bpmn:flowNodeRef><bpmn:flowNodeRef>XOR_Late</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Lapsed</bpmn:flowNodeRef><bpmn:flowNodeRef>UT_ManualNotify</bpmn:flowNodeRef><bpmn:flowNodeRef>XOR_AfterWithdraw</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Committee" name="Review Committee (incl. HoD)"><bpmn:flowNodeRef>UT_EscalateVal</bpmn:flowNodeRef><bpmn:flowNodeRef>UT_Committee</bpmn:flowNodeRef><bpmn:flowNodeRef>UT_HodDecide</bpmn:flowNodeRef><bpmn:flowNodeRef>XOR_Committee</bpmn:flowNodeRef><bpmn:flowNodeRef>XOR_RevLimit</bpmn:flowNodeRef><bpmn:flowNodeRef>TMR_Silent</bpmn:flowNodeRef><bpmn:flowNodeRef>Boundary_Remind</bpmn:flowNodeRef><bpmn:flowNodeRef>Boundary_ReviewSLA</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Guide" name="Faculty Guide"><bpmn:flowNodeRef>EG_GuideWait</bpmn:flowNodeRef><bpmn:flowNodeRef>MSG_Accept</bpmn:flowNodeRef><bpmn:flowNodeRef>XOR_GuideOk</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_System" name="Project Management System"><bpmn:flowNodeRef>ST_Validate</bpmn:flowNodeRef><bpmn:flowNodeRef>XOR_Valid</bpmn:flowNodeRef><bpmn:flowNodeRef>XOR_Retry</bpmn:flowNodeRef><bpmn:flowNodeRef>AND_SplitChecks</bpmn:flowNodeRef><bpmn:flowNodeRef>ST_Similarity</bpmn:flowNodeRef><bpmn:flowNodeRef>AND_JoinChecks</bpmn:flowNodeRef><bpmn:flowNodeRef>XOR_Dup</bpmn:flowNodeRef><bpmn:flowNodeRef>ST_RemindCommittee</bpmn:flowNodeRef><bpmn:flowNodeRef>TH_EscalateHod</bpmn:flowNodeRef><bpmn:flowNodeRef>ST_RejectReasons</bpmn:flowNodeRef><bpmn:flowNodeRef>BR_GuideAvail</bpmn:flowNodeRef><bpmn:flowNodeRef>XOR_GuideAvail</bpmn:flowNodeRef><bpmn:flowNodeRef>ST_Allocate</bpmn:flowNodeRef><bpmn:flowNodeRef>ST_SendAlloc</bpmn:flowNodeRef><bpmn:flowNodeRef>AND_NotifySplit</bpmn:flowNodeRef><bpmn:flowNodeRef>ST_NotifyTeam</bpmn:flowNodeRef><bpmn:flowNodeRef>AND_NotifyJoin</bpmn:flowNodeRef><bpmn:flowNodeRef>ST_LateFlag</bpmn:flowNodeRef><bpmn:flowNodeRef>ST_RetryMail</bpmn:flowNodeRef><bpmn:flowNodeRef>TH_Compensate</bpmn:flowNodeRef><bpmn:flowNodeRef>ST_ReleaseSlot</bpmn:flowNodeRef><bpmn:flowNodeRef>Boundary_NotifyErr</bpmn:flowNodeRef><bpmn:flowNodeRef>Boundary_NotifyErr2</bpmn:flowNodeRef><bpmn:flowNodeRef>Boundary_Withdraw</bpmn:flowNodeRef></bpmn:lane>
      </bpmn:laneSet>
      <bpmn:startEvent id="Start_1" name="Team decides to submit"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
      <bpmn:userTask id="UT_Submit" name="Submit project proposal"><bpmn:incoming>f1</bpmn:incoming><bpmn:incoming>f8</bpmn:incoming><bpmn:incoming>f26</bpmn:incoming><bpmn:incoming>f35</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="ST_Validate" name="Validate form and team rules"><bpmn:incoming>f2</bpmn:incoming><bpmn:incoming>f62</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="XOR_Valid" name="Validation result"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing><bpmn:outgoing>f6</bpmn:outgoing><bpmn:outgoing>f11</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:sendTask id="ST_NotifyInvalid" name="Notify invalid team"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:sendTask>
      <bpmn:endEvent id="End_InvalidTeam" name="Invalid team"><bpmn:incoming>f5</bpmn:incoming><bpmn:errorEventDefinition id="End_InvalidTeam_err"/></bpmn:endEvent>
      <bpmn:exclusiveGateway id="XOR_Retry" name="Resubmit attempts left?"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing><bpmn:outgoing>f9</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="UT_EscalateVal" name="Escalate incomplete proposal"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="UT_Screen" name="Screen proposal"><bpmn:incoming>f10</bpmn:incoming><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:userTask>
      <bpmn:parallelGateway id="AND_SplitChecks" name="Run checks in parallel"><bpmn:incoming>f12</bpmn:incoming><bpmn:outgoing>f13</bpmn:outgoing><bpmn:outgoing>f14</bpmn:outgoing></bpmn:parallelGateway>
      <bpmn:serviceTask id="ST_Similarity" name="Run duplicate-topic check"><bpmn:incoming>f13</bpmn:incoming><bpmn:outgoing>f21</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:businessRuleTask id="BR_EthicsLab" name="Need ethics and/or lab clearance?"><bpmn:incoming>f14</bpmn:incoming><bpmn:outgoing>f15</bpmn:outgoing></bpmn:businessRuleTask>
      <bpmn:inclusiveGateway id="OR_SplitClearance" name="Additional clearances"><bpmn:incoming>f15</bpmn:incoming><bpmn:outgoing>f16</bpmn:outgoing><bpmn:outgoing>f17</bpmn:outgoing><bpmn:outgoing>f17b</bpmn:outgoing></bpmn:inclusiveGateway>
      <bpmn:userTask id="UT_Ethics" name="Complete ethics form"><bpmn:incoming>f16</bpmn:incoming><bpmn:outgoing>f18</bpmn:outgoing></bpmn:userTask>
      <bpmn:userTask id="UT_Lab" name="Request lab / resource booking"><bpmn:incoming>f17</bpmn:incoming><bpmn:outgoing>f19</bpmn:outgoing></bpmn:userTask>
      <bpmn:inclusiveGateway id="OR_JoinClearance" name="Clearances complete"><bpmn:incoming>f17b</bpmn:incoming><bpmn:incoming>f18</bpmn:incoming><bpmn:incoming>f19</bpmn:incoming><bpmn:outgoing>f20</bpmn:outgoing></bpmn:inclusiveGateway>
      <bpmn:parallelGateway id="AND_JoinChecks" name="Checks complete"><bpmn:incoming>f20</bpmn:incoming><bpmn:incoming>f21</bpmn:incoming><bpmn:outgoing>f22</bpmn:outgoing></bpmn:parallelGateway>
      <bpmn:exclusiveGateway id="XOR_Dup" name="Similarity above threshold?"><bpmn:incoming>f22</bpmn:incoming><bpmn:outgoing>f23</bpmn:outgoing><bpmn:outgoing>f24</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="UT_ReviewMatch" name="Review suspected duplicate"><bpmn:incoming>f23</bpmn:incoming><bpmn:outgoing>f25</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="XOR_MatchDec" name="Duplicate decision"><bpmn:incoming>f25</bpmn:incoming><bpmn:outgoing>f26</bpmn:outgoing><bpmn:outgoing>f27</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="UT_Committee" name="Evaluate proposal"><bpmn:incoming>f24</bpmn:incoming><bpmn:incoming>f31</bpmn:incoming><bpmn:incoming>f65</bpmn:incoming><bpmn:outgoing>f28</bpmn:outgoing></bpmn:userTask>
      <bpmn:sendTask id="ST_RemindCommittee" name="Send SLA reminder"><bpmn:incoming>f64</bpmn:incoming><bpmn:outgoing>f65</bpmn:outgoing></bpmn:sendTask>
      <bpmn:intermediateThrowEvent id="TH_EscalateHod" name="Escalate delayed review to HoD"><bpmn:incoming>f66</bpmn:incoming><bpmn:outgoing>f67</bpmn:outgoing><bpmn:escalationEventDefinition id="TH_EscalateHod_esc"/></bpmn:intermediateThrowEvent>
      <bpmn:userTask id="UT_HodDecide" name="HoD takes over decision"><bpmn:incoming>f67</bpmn:incoming><bpmn:outgoing>f28b</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="XOR_Committee" name="Committee outcome"><bpmn:incoming>f28</bpmn:incoming><bpmn:incoming>f28b</bpmn:incoming><bpmn:incoming>f32</bpmn:incoming><bpmn:outgoing>f29</bpmn:outgoing><bpmn:outgoing>f33</bpmn:outgoing><bpmn:outgoing>f37</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="XOR_RevLimit" name="Revision cycles left?"><bpmn:incoming>f29</bpmn:incoming><bpmn:outgoing>f30</bpmn:outgoing><bpmn:outgoing>f32</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="UT_Revise" name="Revise proposal (7 days)"><bpmn:incoming>f30</bpmn:incoming><bpmn:outgoing>f31</bpmn:outgoing></bpmn:userTask>
      <bpmn:sendTask id="ST_RejectReasons" name="Send rejection reasons"><bpmn:incoming>f27</bpmn:incoming><bpmn:incoming>f33</bpmn:incoming><bpmn:outgoing>f34</bpmn:outgoing></bpmn:sendTask>
      <bpmn:exclusiveGateway id="XOR_NewTopic" name="Allow one new topic?"><bpmn:incoming>f34</bpmn:incoming><bpmn:outgoing>f35</bpmn:outgoing><bpmn:outgoing>f36</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_Rejected" name="Proposal rejected"><bpmn:incoming>f36</bpmn:incoming></bpmn:endEvent>
      <bpmn:businessRuleTask id="BR_GuideAvail" name="Match guide by domain and load"><bpmn:incoming>f37</bpmn:incoming><bpmn:incoming>f52</bpmn:incoming><bpmn:incoming>f75</bpmn:incoming><bpmn:outgoing>f38</bpmn:outgoing></bpmn:businessRuleTask>
      <bpmn:exclusiveGateway id="XOR_GuideAvail" name="Guide available?"><bpmn:incoming>f38</bpmn:incoming><bpmn:outgoing>f39</bpmn:outgoing><bpmn:outgoing>f40</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:userTask id="UT_ManualGuide" name="Allocate manually / wait-list"><bpmn:incoming>f39</bpmn:incoming><bpmn:incoming>f53</bpmn:incoming><bpmn:outgoing>f41</bpmn:outgoing></bpmn:userTask>
      <bpmn:serviceTask id="ST_Allocate" name="Reserve guide slot"><bpmn:incoming>f40</bpmn:incoming><bpmn:incoming>f41</bpmn:incoming><bpmn:outgoing>f42</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:sendTask id="ST_SendAlloc" name="Send allocation request"><bpmn:incoming>f42</bpmn:incoming><bpmn:outgoing>f43</bpmn:outgoing></bpmn:sendTask>
      <bpmn:eventBasedGateway id="EG_GuideWait" name="Wait for guide response"><bpmn:incoming>f43</bpmn:incoming><bpmn:outgoing>f44</bpmn:outgoing><bpmn:outgoing>f45</bpmn:outgoing><bpmn:outgoing>f46</bpmn:outgoing></bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="MSG_Accept" name="Guide accepts"><bpmn:incoming>f44</bpmn:incoming><bpmn:outgoing>f47</bpmn:outgoing><bpmn:messageEventDefinition id="MSG_Accept_msg" messageRef="Message_1"/></bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="TMR_Silent" name="No response (5 days)"><bpmn:incoming>f45</bpmn:incoming><bpmn:outgoing>f48</bpmn:outgoing><bpmn:timerEventDefinition id="TMR_Silent_timer"><bpmn:timeDuration xsi:type="tFormalExpression">P5D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="MSG_Decline" name="Guide declines"><bpmn:incoming>f46</bpmn:incoming><bpmn:outgoing>f49</bpmn:outgoing><bpmn:messageEventDefinition id="MSG_Decline_msg" messageRef="Message_Decline"/></bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="XOR_GuideOk" name="Accepted?"><bpmn:incoming>f47</bpmn:incoming><bpmn:incoming>f48</bpmn:incoming><bpmn:incoming>f49</bpmn:incoming><bpmn:outgoing>f50</bpmn:outgoing><bpmn:outgoing>f51</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="XOR_AllocTries" name="Allocation attempts left?"><bpmn:incoming>f51</bpmn:incoming><bpmn:outgoing>f52</bpmn:outgoing><bpmn:outgoing>f53</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:parallelGateway id="AND_NotifySplit" name="Confirm allocation"><bpmn:incoming>f50</bpmn:incoming><bpmn:outgoing>f54</bpmn:outgoing><bpmn:outgoing>f55</bpmn:outgoing></bpmn:parallelGateway>
      <bpmn:sendTask id="ST_NotifyTeam" name="Notify student team"><bpmn:incoming>f54</bpmn:incoming><bpmn:outgoing>f56</bpmn:outgoing></bpmn:sendTask>
      <bpmn:serviceTask id="ST_RecordAlloc" name="Record allocation in register"><bpmn:incoming>f55</bpmn:incoming><bpmn:outgoing>f57</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:parallelGateway id="AND_NotifyJoin" name="Notifications done"><bpmn:incoming>f56</bpmn:incoming><bpmn:incoming>f57</bpmn:incoming><bpmn:incoming>f69</bpmn:incoming><bpmn:incoming>f71</bpmn:incoming><bpmn:outgoing>f58</bpmn:outgoing></bpmn:parallelGateway>
      <bpmn:endEvent id="End_Allocated" name="Guide allocated and confirmed"><bpmn:incoming>f58</bpmn:incoming></bpmn:endEvent>
      <bpmn:serviceTask id="ST_LateFlag" name="Flag late submission"><bpmn:incoming>f59</bpmn:incoming><bpmn:outgoing>f60</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:userTask id="UT_LateApprove" name="Approve or refuse late submission"><bpmn:incoming>f60</bpmn:incoming><bpmn:outgoing>f61</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="XOR_Late" name="Late submission allowed?"><bpmn:incoming>f61</bpmn:incoming><bpmn:outgoing>f62</bpmn:outgoing><bpmn:outgoing>f63</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_Lapsed" name="Proposal lapsed"><bpmn:incoming>f63</bpmn:incoming></bpmn:endEvent>
      <bpmn:serviceTask id="ST_RetryMail" name="Retry notification (max 3)"><bpmn:incoming>f68</bpmn:incoming><bpmn:outgoing>f69</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:userTask id="UT_ManualNotify" name="Notify team manually"><bpmn:incoming>f70</bpmn:incoming><bpmn:outgoing>f71</bpmn:outgoing></bpmn:userTask>
      <bpmn:intermediateThrowEvent id="TH_Compensate" name="Release reserved guide slot"><bpmn:incoming>f72</bpmn:incoming><bpmn:outgoing>f73</bpmn:outgoing><bpmn:compensateEventDefinition id="TH_Compensate_comp" waitForCompletion="true"/></bpmn:intermediateThrowEvent>
      <bpmn:serviceTask id="ST_ReleaseSlot" name="Compensation: free guide slot"><bpmn:incoming>f73</bpmn:incoming><bpmn:outgoing>f74</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="XOR_AfterWithdraw" name="Re-allocate or close?"><bpmn:incoming>f74</bpmn:incoming><bpmn:outgoing>f75</bpmn:outgoing><bpmn:outgoing>f76</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_Withdrawn" name="Case withdrawn"><bpmn:incoming>f76</bpmn:incoming></bpmn:endEvent>
      <bpmn:userTask id="UT_FixValidation" name="Correct form errors"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing></bpmn:userTask>
      <bpmn:boundaryEvent id="Boundary_Deadline" name="Submission deadline" attachedToRef="UT_Submit" cancelActivity="true"><bpmn:outgoing>f59</bpmn:outgoing><bpmn:timerEventDefinition id="Boundary_Deadline_timer"><bpmn:timeDuration xsi:type="tFormalExpression">P14D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="Boundary_Remind" name="Review SLA reminder" attachedToRef="UT_Committee" cancelActivity="false"><bpmn:outgoing>f64</bpmn:outgoing><bpmn:timerEventDefinition id="Boundary_Remind_timer"><bpmn:timeDuration xsi:type="tFormalExpression">P5D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="Boundary_ReviewSLA" name="Review overdue" attachedToRef="UT_Committee" cancelActivity="true"><bpmn:outgoing>f66</bpmn:outgoing><bpmn:timerEventDefinition id="Boundary_ReviewSLA_timer"><bpmn:timeDuration xsi:type="tFormalExpression">P10D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="Boundary_NotifyErr" name="Email / DB error" attachedToRef="ST_NotifyTeam" cancelActivity="true"><bpmn:outgoing>f68</bpmn:outgoing><bpmn:errorEventDefinition id="Boundary_NotifyErr_err"/></bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="Boundary_NotifyErr2" name="Retries exhausted" attachedToRef="ST_RetryMail" cancelActivity="true"><bpmn:outgoing>f70</bpmn:outgoing><bpmn:errorEventDefinition id="Boundary_NotifyErr2_err"/></bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="Boundary_Withdraw" name="Team or guide withdraws" attachedToRef="ST_Allocate" cancelActivity="true"><bpmn:outgoing>f72</bpmn:outgoing><bpmn:messageEventDefinition id="Boundary_Withdraw_msg" messageRef="Message_Withdraw"/></bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="f1" sourceRef="Start_1" targetRef="UT_Submit" />
      <bpmn:sequenceFlow id="f2" sourceRef="UT_Submit" targetRef="ST_Validate" />
      <bpmn:sequenceFlow id="f3" sourceRef="ST_Validate" targetRef="XOR_Valid" />
      <bpmn:sequenceFlow id="f4" sourceRef="XOR_Valid" targetRef="ST_NotifyInvalid" name="Invalid team rules" />
      <bpmn:sequenceFlow id="f5" sourceRef="ST_NotifyInvalid" targetRef="End_InvalidTeam" />
      <bpmn:sequenceFlow id="f6" sourceRef="XOR_Valid" targetRef="XOR_Retry" name="Incomplete / invalid data" />
      <bpmn:sequenceFlow id="f7" sourceRef="XOR_Retry" targetRef="UT_FixValidation" name="Attempts remaining" />
      <bpmn:sequenceFlow id="f8" sourceRef="UT_FixValidation" targetRef="UT_Submit" />
      <bpmn:sequenceFlow id="f9" sourceRef="XOR_Retry" targetRef="UT_EscalateVal" name="2 attempts used" />
      <bpmn:sequenceFlow id="f10" sourceRef="UT_EscalateVal" targetRef="UT_Screen" name="Coordinator admits case" />
      <bpmn:sequenceFlow id="f11" sourceRef="XOR_Valid" targetRef="UT_Screen" name="Valid" />
      <bpmn:sequenceFlow id="f12" sourceRef="UT_Screen" targetRef="AND_SplitChecks" />
      <bpmn:sequenceFlow id="f13" sourceRef="AND_SplitChecks" targetRef="ST_Similarity" />
      <bpmn:sequenceFlow id="f14" sourceRef="AND_SplitChecks" targetRef="BR_EthicsLab" />
      <bpmn:sequenceFlow id="f15" sourceRef="BR_EthicsLab" targetRef="OR_SplitClearance" />
      <bpmn:sequenceFlow id="f16" sourceRef="OR_SplitClearance" targetRef="UT_Ethics" name="Ethics required" />
      <bpmn:sequenceFlow id="f17" sourceRef="OR_SplitClearance" targetRef="UT_Lab" name="Lab / resource required" />
      <bpmn:sequenceFlow id="f17b" sourceRef="OR_SplitClearance" targetRef="OR_JoinClearance" name="No extra clearance" />
      <bpmn:sequenceFlow id="f18" sourceRef="UT_Ethics" targetRef="OR_JoinClearance" />
      <bpmn:sequenceFlow id="f19" sourceRef="UT_Lab" targetRef="OR_JoinClearance" />
      <bpmn:sequenceFlow id="f20" sourceRef="OR_JoinClearance" targetRef="AND_JoinChecks" />
      <bpmn:sequenceFlow id="f21" sourceRef="ST_Similarity" targetRef="AND_JoinChecks" />
      <bpmn:sequenceFlow id="f22" sourceRef="AND_JoinChecks" targetRef="XOR_Dup" />
      <bpmn:sequenceFlow id="f23" sourceRef="XOR_Dup" targetRef="UT_ReviewMatch" name="High similarity" />
      <bpmn:sequenceFlow id="f24" sourceRef="XOR_Dup" targetRef="UT_Committee" name="Unique topic" />
      <bpmn:sequenceFlow id="f25" sourceRef="UT_ReviewMatch" targetRef="XOR_MatchDec" />
      <bpmn:sequenceFlow id="f26" sourceRef="XOR_MatchDec" targetRef="UT_Submit" name="Modify topic" />
